# Backend propio de Connexo (carpeta `backend/`).
# En local: `cd backend && docker compose up -d` deja el API en el 3000.
VITE_API_URL=http://localhost:3000/api

# Llave pública VAPID para Web Push (pública por diseño; la privada es un
# secreto del backend, VAPID_PRIVATE_KEY).
VITE_VAPID_PUBLIC_KEY=
